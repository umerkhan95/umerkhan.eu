---
/**
 * GEO (Generative Engine Optimization) Schema Component
 * Provides structured data and LLM-friendly content for better AI discoverability
 */

interface Props {
  page?: 'home' | 'cv' | 'blog' | 'services' | 'projects';
}

const { page = 'home' } = Astro.props;

const SITE = 'https://umerkhan.io';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE}/#person`,
  "name": "Umer Khan",
  "givenName": "Umer",
  "familyName": "Khan",
  "jobTitle": "Founding AI Engineer",
  "description": "Umer Khan is a founding AI engineer based in Berlin, Germany, specializing in production-grade AI systems, RAG pipelines, LLM engineering, and data architecture. He builds GDPR-compliant AI solutions using Python, FastAPI, LangChain, LangGraph, and AWS.",
  "url": SITE,
  "image": {
    "@type": "ImageObject",
    "@id": `${SITE}/#profile-image`,
    "url": `${SITE}/profile.jpg`,
    "contentUrl": `${SITE}/profile.jpg`,
    "caption": "Umer Khan"
  },
  "email": "mailto:hello@umerkhan.eu",
  "nationality": {
    "@type": "Country",
    "name": "Pakistan"
  },
  "knowsLanguage": ["en", "de", "ur"],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Berlin",
    "addressRegion": "Berlin",
    "addressCountry": "DE"
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "University of Karachi",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Karachi",
      "addressCountry": "PK"
    }
  },
  "knowsAbout": [
    "Artificial Intelligence",
    "Machine Learning",
    "Large Language Models (LLMs)",
    "Retrieval-Augmented Generation (RAG)",
    "LangChain",
    "LangGraph",
    "Model Context Protocol (MCP)",
    "Python",
    "FastAPI",
    "AWS",
    "Data Engineering",
    "ETL Pipelines",
    "Natural Language Processing (NLP)",
    "Vector Databases",
    "Pinecone",
    "ChromaDB",
    "Qdrant"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "AWS Cloud Solutions Architect",
      "credentialCategory": "ProfessionalCertification",
      "recognizedBy": {
        "@type": "Organization",
        "name": "Amazon Web Services",
        "url": "https://aws.amazon.com"
      }
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "Data Science with ML/AI",
      "credentialCategory": "ProfessionalCertification",
      "recognizedBy": {
        "@type": "Organization",
        "name": "IBM",
        "url": "https://www.ibm.com"
      }
    }
  ],
  "worksFor": { "@id": `${SITE}/#bloomers` },
  "sameAs": [
    "https://github.com/umerkhan95",
    "https://linkedin.com/in/umerkhan"
  ]
};

const bloomersOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE}/#bloomers`,
  "name": "Bloomers Berlin",
  "url": "https://bloomers.berlin",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Berlin",
    "addressCountry": "DE"
  }
};

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE}/#profilepage`,
  "url": SITE,
  "name": "Umer Khan | AI & Data Systems Engineer",
  "inLanguage": "en",
  "mainEntity": { "@id": `${SITE}/#person` },
  "about": { "@id": `${SITE}/#person` }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  "name": "Umer Khan - AI Engineer",
  "url": SITE,
  "inLanguage": "en",
  "description": "Personal website of Umer Khan, a founding AI engineer specializing in RAG systems, LLM engineering, and production-grade AI solutions.",
  "author": { "@id": `${SITE}/#person` },
  "publisher": { "@id": `${SITE}/#person` }
};

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${SITE}/#service`,
  "name": "Umer Khan AI Engineering Services",
  "description": "AI engineering consulting and development services including RAG system design, LLM integration, data pipeline architecture, and AI automation.",
  "url": `${SITE}/services`,
  "provider": { "@id": `${SITE}/#person` },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Berlin",
    "addressCountry": "DE"
  },
  "areaServed": [
    { "@type": "Country", "name": "Germany" },
    { "@type": "Place", "name": "European Union" },
    { "@type": "Place", "name": "Remote / Worldwide" }
  ],
  "serviceType": [
    "AI System Design",
    "RAG Pipeline Development",
    "LLM Engineering",
    "Data Architecture",
    "AI Automation",
    "Cloud Solutions"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "AI Engineering Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "RAG System Development",
          "description": "Design and implementation of Retrieval-Augmented Generation systems for enterprise knowledge management"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "LLM Integration",
          "description": "Integration of large language models into existing business workflows and applications"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "AI Agent Development",
          "description": "Development of autonomous AI agents using LangChain, LangGraph, and Model Context Protocol (MCP)"
        }
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${SITE}/#faq`,
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Umer Khan's expertise?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Umer Khan specializes in building production-grade AI systems, including RAG (Retrieval-Augmented Generation) pipelines, LLM engineering, AI agents, and data architecture. He has expertise in Python, FastAPI, LangChain, LangGraph, MCP, and AWS cloud services."
      }
    },
    {
      "@type": "Question",
      "name": "What companies has Umer Khan worked with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Umer Khan has worked with Bloomers Berlin (current), Comparado GmbH (Idealo Group), CorAI (Bernstein Analytics), and Teradata. He has also collaborated with stakeholders from Axel Springer, Bernstein Group, NewsCatcher, and Telenor."
      }
    },
    {
      "@type": "Question",
      "name": "What AI technologies does Umer Khan work with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Umer Khan works with LangChain, LangGraph, Model Context Protocol (MCP), OpenAI, Hugging Face models, PyTorch, and vector databases including Pinecone, ChromaDB, Qdrant, and Milvus. He specializes in building RAG systems and AI agents."
      }
    },
    {
      "@type": "Question",
      "name": "Is Umer Khan available for consulting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, Umer Khan is available for AI engineering consulting, including RAG system design, LLM integration, data pipeline architecture, and AI automation projects. Contact him at hello@umerkhan.eu."
      }
    },
    {
      "@type": "Question",
      "name": "Where is Umer Khan based?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Umer Khan is based in Berlin, Germany. He works with clients worldwide on AI engineering projects."
      }
    }
  ]
};

// Combine schemas based on page
const schemas = page === 'home'
  ? [profilePageSchema, personSchema, bloomersOrg, websiteSchema, professionalServiceSchema, faqSchema]
  : page === 'cv'
  ? [personSchema, bloomersOrg]
  : page === 'services'
  ? [personSchema, bloomersOrg, professionalServiceSchema]
  : [personSchema, bloomersOrg, websiteSchema];
---

<!-- JSON-LD Structured Data for LLMs and Search Engines -->
{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<!-- Author / Robots -->
<meta name="author" content="Umer Khan" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />

<!-- Semantic Keywords -->
<meta name="keywords" content="Umer Khan, AI Engineer, Berlin, RAG systems, LLM engineering, LangChain, LangGraph, MCP, Model Context Protocol, Python, FastAPI, AWS, data engineering, machine learning, artificial intelligence, vector databases, Pinecone, ChromaDB" />
