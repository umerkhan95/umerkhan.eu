---
/**
 * Structured data and robots directives shared by every page.
 * Markup only states what the page itself shows: credentials and education
 * are visible on /cv/, so they are added to the Person node there only.
 */

interface Props {
  page?: 'home' | 'cv' | 'blog';
  noindex?: boolean;
}

const { page = 'home', noindex = false } = Astro.props;

const SITE = 'https://umerkhan.io';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE}/#person`,
  "name": "Umer Khan",
  "givenName": "Umer",
  "familyName": "Khan",
  "jobTitle": "Forward Deployed Engineer",
  "description": "Umer Khan is a Forward Deployed Engineer at Accenture, based in Berlin, Germany. He takes AI systems from prototype to production and builds products for commerce, including the open-source library shopextract.",
  "url": SITE,
  "image": {
    "@type": "ImageObject",
    "@id": `${SITE}/#profile-image`,
    "url": `${SITE}/umer.webp`,
    "contentUrl": `${SITE}/umer.webp`,
    "caption": "Umer Khan"
  },
  "email": "mailto:hello@umerkhan.eu",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Berlin",
    "addressRegion": "Berlin",
    "addressCountry": "DE"
  },
  "worksFor": { "@id": `${SITE}/#employer` },
  "sameAs": [
    "https://github.com/umerkhan95",
    "https://www.linkedin.com/in/umerkhan261/"
  ]
};

// Shown on the resume page only.
const cvDetails = {
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "University of Karachi",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Karachi",
      "addressCountry": "PK"
    }
  },
  "knowsAbout": [
    "Artificial Intelligence",
    "Machine Learning",
    "Large Language Models (LLMs)",
    "Retrieval-Augmented Generation (RAG)",
    "LangChain",
    "LangGraph",
    "Model Context Protocol (MCP)",
    "Python",
    "FastAPI",
    "AWS",
    "Data Engineering",
    "ETL Pipelines",
    "Natural Language Processing (NLP)",
    "Vector Databases",
    "Pinecone",
    "ChromaDB",
    "Qdrant"
  ],
  "hasCredential": [
    {
      "@type": "EducationalOccupationalCredential",
      "name": "AWS Cloud Solutions Architect",
      "credentialCategory": "ProfessionalCertification",
      "recognizedBy": {
        "@type": "Organization",
        "name": "Amazon Web Services",
        "url": "https://aws.amazon.com"
      }
    },
    {
      "@type": "EducationalOccupationalCredential",
      "name": "Data Science with ML/AI",
      "credentialCategory": "ProfessionalCertification",
      "recognizedBy": {
        "@type": "Organization",
        "name": "IBM",
        "url": "https://www.ibm.com"
      }
    }
  ]
};

const employerOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE}/#employer`,
  "name": "Accenture",
  "url": "https://www.accenture.com"
};

const profilePageSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${SITE}/#profilepage`,
  "url": SITE,
  "name": "Umer Khan | Forward Deployed Engineer",
  "inLanguage": "en",
  "mainEntity": { "@id": `${SITE}/#person` },
  "about": { "@id": `${SITE}/#person` }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE}/#website`,
  "name": "Umer Khan",
  "url": SITE,
  "inLanguage": "en",
  "description": "Personal website of Umer Khan, Forward Deployed Engineer at Accenture and builder of commerce products and open-source tools.",
  "author": { "@id": `${SITE}/#person` },
  "publisher": { "@id": `${SITE}/#person` }
};

const person = page === 'cv' ? { ...personSchema, ...cvDetails } : personSchema;

const schemas = page === 'home'
  ? [profilePageSchema, person, employerOrg, websiteSchema]
  : page === 'cv'
  ? [person, employerOrg]
  : [person, employerOrg, websiteSchema];
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}

<meta name="author" content="Umer Khan" />
<meta
  name="robots"
  content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>
