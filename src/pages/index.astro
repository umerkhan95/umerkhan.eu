---
import BaseLayout from "../layouts/BaseLayout.astro";
import SideSection from "../components/SideSection.astro";
import Hero from "../components/Hero.astro";
import MoreLink from "../components/MoreLink.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import { experience, clients, log } from "../data/profile";
import { products } from "../data/products";
import { shortDay } from "../lib/activity";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lastPosts = posts.slice(0, 3);
const recent = log.slice(0, 4);
const [featured, ...otherProducts] = products;
---

<BaseLayout sideBarActiveItemID="home">
  <Hero />

  <div class="rule"></div>

  <SideSection title="Experience" subtitle={`${experience.length} roles`}>
    <div>
      {experience.map((exp) => (
        <div class="row flex items-start gap-6 py-4">
          <span class="text-sm w-16 shrink-0 pt-0.5 tabular-nums">
            {exp.current ? (
              <span class="inline-flex items-center gap-2 font-medium text-base-content">
                <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                Now
              </span>
            ) : (
              <span class="text-base-content/40">{exp.year}</span>
            )}
          </span>
          <div class="flex-1 min-w-0">
            <div class="font-medium text-base-content">{exp.company}</div>
            <div class="text-sm text-base-content/50">{exp.role}</div>
            <p class="text-sm text-base-content/40 mt-1">{exp.summary}</p>
          </div>
        </div>
      ))}
    </div>
    <MoreLink href="/cv/">Full resume</MoreLink>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Building" subtitle={`${products.length} products`}>
    <a href={featured.link} data-astro-reload class="group block pb-6">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="text-xl font-semibold tracking-tight text-base-content">{featured.name}</h3>
        <span class="text-[11px] uppercase tracking-wider text-base-content/40 shrink-0">{featured.badge}</span>
      </div>
      <p class="text-base-content/60 mt-2 max-w-xl">{featured.description}</p>
      <span class="inline-flex items-center gap-1.5 mt-3 text-sm text-base-content/60 group-hover:text-base-content transition-colors">
        Read more
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
      </span>
    </a>
    <div class="border-t border-base-300/40">
      {otherProducts.map((product) => (
        <a href={product.link} data-astro-reload class="row group flex items-baseline gap-6 py-3.5">
          <span class="font-medium text-base-content w-28 shrink-0">{product.name}</span>
          <span class="flex-1 min-w-0 text-sm text-base-content/50 group-hover:text-base-content/80 transition-colors">{product.tagline}</span>
          <span class="hidden sm:block text-[11px] uppercase tracking-wider text-base-content/30 shrink-0">{product.badge}</span>
        </a>
      ))}
    </div>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Recent" subtitle="From the log">
    <div>
      {recent.map((entry) => (
        <div class="row flex items-baseline gap-6 py-3.5">
          <span class="text-xs text-base-content/40 w-16 shrink-0 tabular-nums">{shortDay(entry.date)}</span>
          <p class="flex-1 min-w-0 text-sm text-base-content/70">
            {entry.context && <span class="text-base-content font-medium">{entry.context}. </span>}
            {entry.text}
          </p>
          <span class="hidden sm:block text-[11px] uppercase tracking-wider text-base-content/30 shrink-0">{entry.kind}</span>
        </div>
      ))}
    </div>
    <MoreLink href="/activity/">All activity</MoreLink>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Writing" subtitle={`${posts.length} articles`}>
    <div>
      {lastPosts.map((post) => (
        <a href={"/blog/" + createSlug(post.data.title, post.slug) + "/"} class="row group flex items-baseline gap-6 py-3.5">
          <span class="text-xs text-base-content/40 w-16 shrink-0 tabular-nums">
            {new Date(post.data.pubDate).toLocaleDateString("en-US", { month: "short", year: "numeric" })}
          </span>
          <div class="flex-1 min-w-0">
            <h3 class="text-[0.9375rem] font-medium text-base-content line-clamp-1">{post.data.title}</h3>
            <p class="text-sm text-base-content/50 line-clamp-1 mt-0.5">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
    <MoreLink href="/blog/">All posts</MoreLink>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Worked With" subtitle="Select clients">
    <ul class="flex flex-wrap gap-x-7 gap-y-2 text-base-content/70">
      {clients.map((client) => <li>{client}</li>)}
    </ul>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Contact" subtitle="Get in touch">
    <p class="text-base-content/60 mb-5 max-w-lg">
      Happy to talk about open source, products, or speaking.
    </p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
      <a href="mailto:hello@umerkhan.eu" class="font-medium text-base-content underline decoration-base-content/20 underline-offset-4 hover:decoration-base-content transition-colors">
        hello@umerkhan.eu
      </a>
      <a href="https://github.com/umerkhan95" target="_blank" rel="noopener" class="text-base-content/60 hover:text-base-content transition-colors">GitHub</a>
      <a href="https://www.linkedin.com/in/umerkhan261/" target="_blank" rel="noopener" class="text-base-content/60 hover:text-base-content transition-colors">LinkedIn</a>
    </div>
  </SideSection>
</BaseLayout>
