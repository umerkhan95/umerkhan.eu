---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Umer Khan" description="This page does not exist." geoPage="blog" noindex>
  <section class="py-24">
    <p class="text-xs font-semibold uppercase tracking-widest text-base-content/40 mb-4">404</p>
    <h1 class="text-3xl md:text-4xl font-semibold tracking-tight text-base-content mb-4">Page not found</h1>
    <p class="text-base-content/60 mb-6">This page does not exist or has moved.</p>
    <a href="/" class="text-sm font-medium text-base-content underline decoration-base-content/20 underline-offset-4 hover:decoration-base-content transition-colors">Back to home</a>
  </section>
</BaseLayout>
