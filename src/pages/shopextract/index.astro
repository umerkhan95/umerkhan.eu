---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SideSection from "../../components/SideSection.astro";
import MoreLink from "../../components/MoreLink.astro";

const REPO = "https://github.com/umerkhan95/shopextract";
const PYPI = "https://pypi.org/project/shopextract/";

// Agent tools and evidence-backed matching are on the main branch and are not
// in the PyPI release yet. Set this to true after the next release.
const AGENT_TOOLS_RELEASED = false;

const capabilities = [
  { name: "Extract", text: "Point it at a store URL. It detects the platform, finds the product pages and returns titles, prices, images, variants, SKUs and GTINs." },
  { name: "Compare", text: "Search one product across several stores, or compare two whole catalogs and see what is cheaper where." },
  { name: "Monitor", text: "Take snapshots over time and report price changes, new products and removals." },
  { name: "Validate", text: "Check product data against Google Shopping, idealo, Amazon or eBay feed rules before you submit it." },
  { name: "Export", text: "JSON, CSV, marketplace feeds, pandas DataFrame or Parquet." },
];

const commands = [
  { cmd: "shopextract extract <url>", does: "Extract products from a store. -n limits URLs, -f picks json or csv, -o writes a file." },
  { cmd: "shopextract detect <url>", does: "Report which e-commerce platform the store runs on." },
  { cmd: "shopextract discover <url>", does: "List product URLs without extracting them." },
  { cmd: "shopextract compare <query>", does: "Compare prices for one product across stores. Repeat -s for each store." },
  { cmd: "shopextract snapshot <url>", does: "Save the catalog as it is now." },
  { cmd: "shopextract changes <domain>", does: "Show what changed between two snapshots." },
  { cmd: "shopextract history <domain> <product>", does: "Price history for one product." },
  { cmd: "shopextract analyze <url>", does: "Catalog statistics: price buckets, outliers, brand share." },
  { cmd: "shopextract validate <file>", does: "Validate products against a marketplace. -m names the marketplace." },
];

const agentTools = [
  { name: "discover", does: "Find product URLs on an allowed store." },
  { name: "extract", does: "Return normalised products and variants, with the evidence for each field." },
  { name: "match", does: "Match two catalogs. Uncertain matches stay uncertain." },
  { name: "changes", does: "Report changes between two captures of the same store." },
  { name: "evidence", does: "Return the captured source for a field, without fetching the page again." },
];

const relations = ["exact", "variant", "bundle", "substitute", "uncertain", "unmatched"];

const tiers = [
  { name: "API", works: "Shopify, WooCommerce, Magento. Shopware and BigCommerce when access is available.", note: "Fastest" },
  { name: "Structured data", works: "Any site with JSON-LD or Open Graph tags.", note: "No browser" },
  { name: "CSS", works: "Any site, through a browser.", note: "Slower" },
  { name: "LLM", works: "JS-heavy sites with no structured data. Any LiteLLM provider, or a local model with Ollama.", note: "Fallback" },
];

const benchmark = [
  { metric: "Product pages correct", ours: "21 of 27", theirs: "18 of 27" },
  { metric: "Wrong product returned", ours: "0", theirs: "3" },
  { metric: "Category pages that worked", ours: "7 of 10", theirs: "8 of 10" },
  { metric: "Category page, median time", ours: "17.3 s", theirs: "about 39 s" },
  { metric: "Product page, median time", ours: "5.5 s", theirs: "about 3.3 s" },
];

const fields = [
  { metric: "ID or SKU", ours: "21", theirs: "12" },
  { metric: "Price with currency", ours: "21", theirs: "18" },
  { metric: "Image", ours: "21", theirs: "18" },
  { metric: "Category", ours: "15", theirs: "6" },
  { metric: "GTIN or MPN", ours: "6", theirs: "0" },
  { metric: "Description", ours: "15", theirs: "15" },
  { metric: "Brand", ours: "9", theirs: "9" },
];

const quickStart = `import asyncio
import shopextract

async def main():
    result = await shopextract.extract("https://example-store.com")
    print(result.platform, result.product_count)
    for product in result.products:
        print(product.title, product.price, product.currency)

asyncio.run(main())`;

const compareCli = `shopextract compare "Wireless Headphones" \\
  -s https://store-a.com \\
  -s https://store-b.com`;

const compareCatalogs = `diff = await shopextract.compare_catalogs(
    "https://store-a.com",
    "https://store-b.com",
)
print(len(diff.in_both), len(diff.cheaper_in_a), len(diff.cheaper_in_b))`;

const mcpServer = `pip install 'shopextract[mcp]'
python -m shopextract.tools --config tools-config.json`;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "@id": "https://umerkhan.io/shopextract/#software",
  "name": "shopextract",
  "description": "An open-source Python library and command-line tool that extracts, compares and monitors product data from online stores.",
  "url": "https://umerkhan.io/shopextract/",
  "codeRepository": REPO,
  "programmingLanguage": "Python",
  "runtimePlatform": "Python 3.10+",
  "license": "https://opensource.org/licenses/MIT",
  "author": { "@id": "https://umerkhan.io/#person" },
  "sameAs": [REPO, PYPI],
};

const unreleasedNote = AGENT_TOOLS_RELEASED ? null : "On the main branch. Not in the PyPI release yet.";
---

<BaseLayout
  sideBarActiveItemID="shopextract"
  title="ShopExtract: product data from any online store | Umer Khan"
  geoPage="blog"
  description="shopextract is an open-source Python library and CLI that extracts, compares and monitors product data from online stores."
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <section class="py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-6 lg:gap-12">
      <div class="lg:text-right">
        <span class="text-xs font-semibold uppercase tracking-widest text-base-content/40">Open source</span>
      </div>
      <div>
        <h1 class="reveal text-3xl md:text-4xl font-semibold tracking-tight text-base-content mb-4">ShopExtract</h1>
        <p class="reveal text-base md:text-lg text-base-content/60 leading-relaxed max-w-xl mb-6" style="--reveal-delay: 60ms">
          A Python library and command-line tool that extracts, compares and monitors product data from online stores. MIT licensed.
        </p>
        <pre class="reveal code max-w-xl" style="--reveal-delay: 120ms"><code>pip install shopextract</code></pre>
        <div class="reveal flex flex-wrap items-center gap-x-6 gap-y-3 text-sm mt-6" style="--reveal-delay: 180ms">
          <a href={REPO} target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 font-medium text-base-content underline decoration-base-content/20 underline-offset-4 hover:decoration-base-content transition-colors">
            GitHub
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
          </a>
          <a href={PYPI} target="_blank" rel="noopener" class="text-base-content/60 hover:text-base-content transition-colors">PyPI</a>
          <a href={`${REPO}/tree/main/docs`} target="_blank" rel="noopener" class="text-base-content/60 hover:text-base-content transition-colors">Full docs</a>
          <span class="text-base-content/40">Python 3.10+</span>
        </div>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <SideSection title="Capabilities" subtitle="What it does">
    <dl>
      {capabilities.map((item) => (
        <div class="row flex items-baseline gap-6 py-3.5">
          <dt class="w-20 shrink-0 font-medium text-base-content">{item.name}</dt>
          <dd class="flex-1 min-w-0 text-sm text-base-content/60">{item.text}</dd>
        </div>
      ))}
    </dl>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Quick start" subtitle="Python">
    <pre class="code"><code>{quickStart}</code></pre>
    <p class="mt-4 text-sm text-base-content/50 max-w-xl">
      One call handles platform detection, URL discovery and extraction. It tries the fastest method first and falls back on its own.
    </p>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="CLI" subtitle={`${commands.length} commands`}>
    <p class="text-sm text-base-content/60 max-w-xl mb-4">
      Everything the library does is also a command, so it works in a shell script or a cron job without writing Python.
    </p>
    <div>
      {commands.map((item) => (
        <div class="row flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-3.5">
          <code class="sm:w-72 shrink-0 font-mono text-[13px] text-base-content">{item.cmd}</code>
          <span class="flex-1 min-w-0 text-sm text-base-content/50">{item.does}</span>
        </div>
      ))}
    </div>
    <a href={`${REPO}/blob/main/docs/cli.md`} target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 mt-6 text-sm font-medium text-base-content/60 hover:text-base-content transition-colors">
      CLI reference
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
    </a>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Agent tools" subtitle="MCP server">
    <p class="text-sm text-base-content/60 max-w-xl mb-4">
      An AI agent can drive shopextract through an MCP server. The server runs on your machine, needs no model or account, and only reads. The operator lists which stores the agent may reach; every other origin is denied.
    </p>
    <div>
      {agentTools.map((tool) => (
        <div class="row flex items-baseline gap-6 py-3.5">
          <code class="w-20 shrink-0 font-mono text-[13px] text-base-content">{tool.name}</code>
          <span class="flex-1 min-w-0 text-sm text-base-content/50">{tool.does}</span>
        </div>
      ))}
    </div>
    <pre class="code mt-5"><code>{mcpServer}</code></pre>
    {unreleasedNote && <p class="mt-3 text-xs text-base-content/40">{unreleasedNote}</p>}
    <a href={`${REPO}/blob/main/docs/agent-tools.md`} target="_blank" rel="noopener" class="group inline-flex items-center gap-1.5 mt-6 text-sm font-medium text-base-content/60 hover:text-base-content transition-colors">
      Agent tools guide
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
    </a>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Comparison" subtitle="Across stores">
    <p class="text-sm text-base-content/60 max-w-xl mb-4">
      Search one product across stores and get the cheapest, the most expensive, the average and the spread.
    </p>
    <pre class="code"><code>{compareCli}</code></pre>
    <p class="text-sm text-base-content/60 max-w-xl mt-6 mb-4">
      Or compare two whole catalogs: what only one store has, what both have, and which store is cheaper.
    </p>
    <pre class="code"><code>{compareCatalogs}</code></pre>
    <p class="text-sm text-base-content/60 max-w-xl mt-6 mb-3">
      Every pair of products gets one of six relations, with the evidence behind it. Only a unique exact match in the same currency enters a price comparison. A similar title alone is a candidate for review, not a match.
    </p>
    <ul class="flex flex-wrap gap-x-5 gap-y-1.5 font-mono text-[13px] text-base-content/70">
      {relations.map((relation) => <li class="text-[13px] text-base-content/70">{relation}</li>)}
    </ul>
    {unreleasedNote && <p class="mt-3 text-xs text-base-content/40">Relation reports are on the main branch. Not in the PyPI release yet.</p>}
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Benchmark" subtitle="vs Firecrawl">
    <p class="text-sm text-base-content/60 max-w-xl mb-4">
      Ten Pakistani stores, one category page and three product pages each, on 7 Nov 2026. Both tools got the same URLs.
    </p>
    <table class="w-full text-sm tabular-nums">
      <thead>
        <tr class="text-left text-[11px] uppercase tracking-wider text-base-content/40">
          <th class="font-medium py-2 pr-4"></th>
          <th class="font-medium py-2 pr-4 w-24 sm:w-32">shopextract</th>
          <th class="font-medium py-2 w-24 sm:w-32">Firecrawl</th>
        </tr>
      </thead>
      <tbody>
        {benchmark.map((line) => (
          <tr class="row-line">
            <td class="py-3 pr-4 text-base-content/60">{line.metric}</td>
            <td class="py-3 pr-4 font-medium text-base-content">{line.ours}</td>
            <td class="py-3 text-base-content/60">{line.theirs}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="text-sm text-base-content/60 max-w-xl mt-8 mb-4">
      Fields filled, out of the 21 product pages each tool returned.
    </p>
    <table class="w-full text-sm tabular-nums">
      <tbody>
        {fields.map((line) => (
          <tr class="row-line">
            <td class="py-3 pr-4 text-base-content/60">{line.metric}</td>
            <td class="py-3 pr-4 w-24 sm:w-32 font-medium text-base-content">{line.ours}</td>
            <td class="py-3 w-24 sm:w-32 text-base-content/60">{line.theirs}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <ul class="mt-6 space-y-1.5 text-xs text-base-content/40 max-w-xl">
      <li class="text-xs leading-relaxed text-base-content/40">One run, ten stores. It is not a claim about every store.</li>
      <li class="text-xs leading-relaxed text-base-content/40">Firecrawl reached two stores that shopextract did not, from its cloud IPs.</li>
      <li class="text-xs leading-relaxed text-base-content/40">Three of Firecrawl's 21 product pages were the wrong product, so its field counts include them.</li>
      <li class="text-xs leading-relaxed text-base-content/40">shopextract was run from the main branch, which is ahead of the PyPI release.</li>
    </ul>
    <MoreLink href="/blog/shopextract-vs-firecrawl-an-initial-benchmark-on-10-pakistani-stores/">How it was run</MoreLink>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Coverage" subtitle="How it extracts">
    <div>
      {tiers.map((tier) => (
        <div class="row flex items-baseline gap-6 py-3.5">
          <span class="w-28 shrink-0 font-medium text-base-content">{tier.name}</span>
          <span class="flex-1 min-w-0 text-sm text-base-content/50">{tier.works}</span>
          <span class="hidden sm:block text-[11px] uppercase tracking-wider text-base-content/30 shrink-0">{tier.note}</span>
        </div>
      ))}
    </div>
  </SideSection>

  <section class="py-10 border-t border-base-300/50">
    <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-6 lg:gap-12">
      <div></div>
      <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-base-content/40">
        <span>MIT licensed. Issues and pull requests are welcome.</span>
        <a href={REPO} target="_blank" rel="noopener" class="text-base-content/60 hover:text-base-content transition-colors">GitHub &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .code {
    margin: 0;
    padding: 0.875rem 1rem;
    overflow-x: auto;
    border: 1px solid oklch(var(--bc) / 0.1);
    border-radius: 0.5rem;
    background: oklch(var(--bc) / 0.03);
    font-size: 13px;
    line-height: 1.6;
  }
  .row-line + .row-line td {
    border-top: 1px solid oklch(var(--bc) / 0.07);
  }
</style>
