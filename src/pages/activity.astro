---
import BaseLayout from "../layouts/BaseLayout.astro";
import SideSection from "../components/SideSection.astro";
import { loadActivityData } from "../lib/github";
import { groupByWeek, pulse, shortDay, shortMonth, monthYear } from "../lib/activity";
import { role, log } from "../data/profile";
import { products } from "../data/products";

const { commitsByDate, analytics, fetchedAt } = loadActivityData();
const weeks = groupByWeek(commitsByDate);
const strip = pulse(weeks);
const stripMax = Math.max(1, ...strip.map((w) => w.count));
const stripTotal = strip.reduce((sum, w) => sum + w.count, 0);
const stripActive = strip.filter((w) => w.count > 0).length;
const repoCount = Object.keys(analytics.commitsByRepo).length;

// One timeline: hand-kept log entries and weekly commit roll-ups, newest first.
type Item =
  | { type: "entry"; date: string; entry: (typeof log)[number] }
  | { type: "week"; date: string; week: (typeof weeks)[number] };

const items: Item[] = [
  ...log.map((entry) => ({ type: "entry" as const, date: entry.date, entry })),
  ...weeks.map((week) => ({ type: "week" as const, date: week.start, week })),
].sort((a, b) => b.date.localeCompare(a.date) || (a.type === "entry" ? -1 : 1));

const months: { key: string; items: Item[] }[] = [];
for (const item of items) {
  const key = item.date.slice(0, 7);
  const last = months[months.length - 1];
  if (last?.key === key) last.items.push(item);
  else months.push({ key, items: [item] });
}

const building = products[0];
const updated = fetchedAt
  ? new Date(fetchedAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })
  : null;
---

<BaseLayout title="Activity | Umer Khan" description="What Umer Khan is working on now, what shipped, and the commit history behind it." sideBarActiveItemID="activity" geoPage="blog">
  <section class="py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-6 lg:gap-12">
      <div class="lg:text-right">
        <span class="text-xs font-semibold uppercase tracking-widest text-base-content/40">Log</span>
      </div>
      <div>
        <h1 class="reveal text-3xl md:text-4xl font-semibold tracking-tight text-base-content mb-4">Activity</h1>
        <p class="reveal text-base-content/60 leading-relaxed max-w-xl" style="--reveal-delay: 60ms">
          What I am working on, what shipped, and the commits behind it.
        </p>
      </div>
    </div>
  </section>

  <div class="rule"></div>

  <SideSection title="Now" subtitle={`Since ${role.sinceLabel}`}>
    <dl class="text-sm">
      <div class="row flex items-baseline gap-6 py-3.5">
        <dt class="w-20 shrink-0 text-base-content/40">Work</dt>
        <dd class="flex-1 min-w-0 text-base-content">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-success mr-2 align-middle"></span>{role.title} at {role.company}
        </dd>
      </div>
      <div class="row flex items-baseline gap-6 py-3.5">
        <dt class="w-20 shrink-0 text-base-content/40">Building</dt>
        <dd class="flex-1 min-w-0 text-base-content">
          <a href={building.link} data-astro-reload class="underline decoration-base-content/20 underline-offset-4 hover:decoration-base-content transition-colors">{building.name}</a>
          <span class="text-base-content/50"> {building.tagline}</span>
        </dd>
      </div>
    </dl>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Products" subtitle={`${products.length} total`}>
    <div>
      {products.map((product) => (
        <a href={product.link} data-astro-reload class="row group flex items-baseline gap-6 py-3.5">
          <span class="font-medium text-base-content w-28 shrink-0">{product.name}</span>
          <span class="flex-1 min-w-0 text-sm text-base-content/50 group-hover:text-base-content/80 transition-colors">{product.tagline}</span>
          <span class="hidden sm:block text-[11px] uppercase tracking-wider text-base-content/30 shrink-0">{product.badge}</span>
        </a>
      ))}
    </div>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Pulse" subtitle="Last 52 weeks">
    <div class="flex items-end gap-[3px] h-14" role="img" aria-label={`${stripTotal} commits across ${stripActive} of the last 52 weeks`}>
      {strip.map((week) => (
        <div
          class="pulse-bar flex-1 min-w-0 rounded-[1px]"
          style={week.count > 0
            ? `height: ${Math.max(8, (week.count / stripMax) * 100)}%; opacity: ${0.35 + 0.65 * (week.count / stripMax)}`
            : "height: 2px; opacity: 0.12"}
          title={`Week of ${shortDay(week.start)}: ${week.count} ${week.count === 1 ? "commit" : "commits"}`}
        ></div>
      ))}
    </div>
    <div class="flex justify-between mt-2 text-[11px] text-base-content/30 tabular-nums">
      <span>{shortMonth(strip[0].start)}</span>
      <span>{shortMonth(strip[Math.floor(strip.length / 2)].start)}</span>
      <span>{shortMonth(strip[strip.length - 1].start)}</span>
    </div>
    <p class="mt-5 text-sm text-base-content/50 tabular-nums">
      <span class="text-base-content">{stripTotal}</span> commits in <span class="text-base-content">{stripActive}</span> active weeks.
      {analytics.stats.totalCommits} in total across {repoCount} tracked {repoCount === 1 ? "repository" : "repositories"}.
    </p>
  </SideSection>

  <div class="rule"></div>

  <SideSection title="Log" subtitle="Newest first">
    {months.length === 0 ? (
      <p class="text-base-content/50">Nothing logged yet.</p>
    ) : (
      <div class="space-y-10">
        {months.map((month) => (
          <div>
            <h3 class="text-xs font-medium text-base-content/40 tabular-nums mb-1">{monthYear(`${month.key}-01`)}</h3>
            <div>
              {month.items.map((item) =>
                item.type === "entry" ? (
                  <div class="row flex items-baseline gap-6 py-3.5">
                    <span class="text-xs text-base-content/40 w-16 shrink-0 tabular-nums">{shortDay(item.date)}</span>
                    <p class="flex-1 min-w-0 text-sm text-base-content/70">
                      {item.entry.context && <span class="text-base-content font-medium">{item.entry.context}. </span>}
                      {item.entry.url ? (
                        <a href={item.entry.url} class="underline decoration-base-content/20 underline-offset-4 hover:decoration-base-content hover:text-base-content transition-colors">{item.entry.text}</a>
                      ) : (
                        item.entry.text
                      )}
                    </p>
                    <span class="hidden sm:block text-[11px] uppercase tracking-wider text-base-content/30 shrink-0">{item.entry.kind}</span>
                  </div>
                ) : (
                  <details class="row group/week">
                    <summary class="flex items-baseline gap-6 py-3.5 cursor-pointer list-none">
                      <span class="text-xs text-base-content/40 w-16 shrink-0 tabular-nums">{shortDay(item.date)}</span>
                      <span class="flex-1 min-w-0 text-sm text-base-content/50 group-hover/week:text-base-content/80 transition-colors">
                        <span class="tabular-nums">{item.week.commits.length}</span> {item.week.commits.length === 1 ? "commit" : "commits"}
                        <span class="text-base-content/30"> in {item.week.repos.join(", ")}</span>
                      </span>
                      <span aria-hidden="true" class="text-base-content/30 text-xs shrink-0 transition-transform group-open/week:rotate-45">+</span>
                    </summary>
                    <ul class="pb-4 pl-[5.5rem] space-y-1.5">
                      {item.week.commits.map((commit) => (
                        <li class="flex items-baseline gap-3 text-[13px] leading-snug">
                          <a href={commit.url} target="_blank" rel="noopener" class="flex-1 min-w-0 truncate text-base-content/60 hover:text-base-content transition-colors">{commit.message}</a>
                          <span class="hidden sm:block font-mono text-[11px] text-base-content/30 shrink-0">{commit.repo}</span>
                        </li>
                      ))}
                    </ul>
                  </details>
                )
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </SideSection>

  <section class="py-10 border-t border-base-300/50">
    <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-6 lg:gap-12">
      <div></div>
      <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-base-content/40">
        <span>{updated ? `Commit data updated ${updated}` : "Commit data refreshes on every deploy."}</span>
        <a href="https://github.com/umerkhan95" target="_blank" rel="noopener" class="text-base-content/60 hover:text-base-content transition-colors">GitHub &rarr;</a>
      </div>
    </div>
  </section>
</BaseLayout>
