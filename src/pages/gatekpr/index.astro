---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SideSection from "../../components/SideSection.astro";
import { FadeIn } from "../../components/react/FadeIn";

const features = [
  {
    title: "110+ Validation Rules",
    description: "Comprehensive rule coverage across webhooks, API usage, billing, security, and OAuth compliance."
  },
  {
    title: "Multi-Language Parsing",
    description: "Supports JavaScript, TypeScript, Ruby, Python, PHP, and Liquid via tree-sitter grammars."
  },
  {
    title: "CLI Interface",
    description: "Fast command-line tool for local development and CI/CD pipeline integration."
  },
  {
    title: "REST API",
    description: "HTTP server mode for integrating validation into existing workflows and services."
  },
  {
    title: "MCP Server",
    description: "Model Context Protocol integration for AI-assisted code review and validation."
  },
  {
    title: "Detailed Reports",
    description: "Structured output with severity levels, file locations, and actionable fix suggestions."
  }
];

const techStack = [
  { name: "Rust", category: "Language" },
  { name: "tree-sitter", category: "Parsing" },
  { name: "Actix Web", category: "HTTP" },
  { name: "Serde", category: "Serialization" },
  { name: "Tokio", category: "Async Runtime" },
  { name: "MCP SDK", category: "AI Integration" }
];

const ruleCategories = [
  { name: "Webhooks", description: "HMAC verification, idempotency, retry handling, and endpoint security" },
  { name: "API Usage", description: "Rate limiting, pagination, versioning, and error handling patterns" },
  { name: "Billing", description: "Charge creation, subscription handling, and usage-based billing compliance" },
  { name: "Security", description: "Token storage, CSRF protection, content security policies, and input validation" },
  { name: "OAuth", description: "Authorization flow, token refresh, scope validation, and session management" },
  { name: "Performance", description: "Caching strategies, bulk operations, and resource optimization" }
];

const platforms = [
  "Shopify",
  "WooCommerce"
];
---

<BaseLayout
  sideBarActiveItemID="gatekpr"
  title="GateKpr | Umer Khan"
  description="Rust-native validation platform for Shopify and WooCommerce apps with 110+ rules across webhooks, API usage, billing, security, and OAuth."
>
  <!-- Hero Section -->
  <FadeIn client:load>
    <div class="py-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3 py-1 text-xs font-medium bg-orange-500/15 text-orange-500 rounded-full border border-orange-500/25">
          Developer Tool
        </span>
        <span class="px-3 py-1 text-xs font-medium bg-success/15 text-success rounded-full border border-success/25">
          Open Source
        </span>
      </div>
      <h1 class="text-3xl md:text-4xl font-bold text-base-content mb-4">
        GateKpr
      </h1>
      <p class="text-lg text-base-content/60 max-w-2xl mb-6">
        Rust-native validation platform for Shopify and WooCommerce apps. 110+ rules across webhooks, API usage, billing, security, and OAuth with multi-language parsing via tree-sitter.
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href="https://github.com/umerkhan95/gatekpr"
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium bg-base-content text-base-100 rounded-lg hover:bg-base-content/90 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View on GitHub
        </a>
      </div>
    </div>
  </FadeIn>

  <div class="w-full h-px bg-base-300/50"></div>

  <!-- Overview Section -->
  <FadeIn client:load delay={0.05}>
    <SideSection title="Overview" subtitle="What is GateKpr?">
      <div class="space-y-4 text-base-content/60">
        <p>
          <strong class="text-base-content">GateKpr</strong> is a fast, comprehensive validation platform built in Rust for e-commerce app developers. It statically analyzes your codebase to catch compliance issues, security vulnerabilities, and best-practice violations before they reach production.
        </p>
        <p>The platform provides:</p>
        <ul class="space-y-2 ml-4">
          <li class="flex items-start gap-2">
            <span><strong class="text-base-content">Static analysis</strong> - Multi-language code parsing via tree-sitter grammars</span>
          </li>
          <li class="flex items-start gap-2">
            <span><strong class="text-base-content">Platform rules</strong> - Shopify and WooCommerce specific validation rules</span>
          </li>
          <li class="flex items-start gap-2">
            <span><strong class="text-base-content">Multiple interfaces</strong> - CLI, REST API, and MCP server for flexible integration</span>
          </li>
          <li class="flex items-start gap-2">
            <span><strong class="text-base-content">Actionable output</strong> - Detailed reports with severity levels and fix suggestions</span>
          </li>
        </ul>
      </div>
    </SideSection>
  </FadeIn>

  <div class="w-full h-px bg-base-300/50"></div>

  <!-- Features Section -->
  <FadeIn client:load delay={0.1}>
    <SideSection title="Features" subtitle={`${features.length} capabilities`}>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {features.map((feature) => (
          <div class="p-4 bg-base-200/30 rounded-xl border border-base-300/30 hover:border-base-300/60 transition-colors">
            <div>
              <h3 class="font-medium text-base-content">{feature.title}</h3>
              <p class="text-sm text-base-content/50 mt-1">{feature.description}</p>
            </div>
          </div>
        ))}
      </div>
    </SideSection>
  </FadeIn>

  <div class="w-full h-px bg-base-300/50"></div>

  <!-- Rule Categories Section -->
  <FadeIn client:load delay={0.2}>
    <SideSection title="Rules" subtitle="Validation categories">
      <div class="space-y-3">
        {ruleCategories.map((item) => (
          <div class="flex items-start gap-4 p-3 bg-base-200/20 rounded-lg">
            <div class="w-8 h-8 rounded-full bg-orange-500/10 text-orange-500 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="flex-1">
              <span class="font-medium text-base-content">{item.name}</span>
              <p class="text-sm text-base-content/50 mt-0.5">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </SideSection>
  </FadeIn>

  <div class="w-full h-px bg-base-300/50"></div>

  <!-- Platforms Section -->
  <FadeIn client:load delay={0.25}>
    <SideSection title="Platforms" subtitle="Supported e-commerce">
      <div class="space-y-4 text-base-content/60">
        <p>
          GateKpr validates apps built for major e-commerce platforms with platform-specific rule sets:
        </p>
        <div class="flex flex-wrap gap-2">
          {platforms.map((platform) => (
            <span class="px-3 py-1.5 text-sm text-base-content/70 bg-base-200/40 rounded-lg border border-base-300/40">
              {platform}
            </span>
          ))}
        </div>
      </div>
    </SideSection>
  </FadeIn>

  <div class="w-full h-px bg-base-300/50"></div>

  <!-- Tech Stack Section -->
  <FadeIn client:load delay={0.3}>
    <SideSection title="Tech Stack" subtitle="Built with">
      <div class="flex flex-wrap gap-2">
        {techStack.map((tech) => (
          <span class="px-3 py-1.5 text-sm text-base-content/70 bg-base-200/40 rounded-lg border border-base-300/40 hover:border-base-300 hover:bg-base-200/60 transition-all">
            {tech.name}
          </span>
        ))}
      </div>
    </SideSection>
  </FadeIn>

  <div class="w-full h-px bg-base-300/50"></div>

  <!-- CTA Section -->
  <FadeIn client:load delay={0.35}>
    <SideSection title="Get Started" subtitle="Try GateKpr">
      <p class="text-base-content/60 mb-6 max-w-lg">
        Validate your e-commerce app against 110+ rules. Install via cargo or use the REST API for CI/CD integration.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a
          href="https://github.com/umerkhan95/gatekpr"
          target="_blank"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium bg-base-content text-base-100 rounded-lg hover:bg-base-content/90 transition-colors"
        >
          View on GitHub
        </a>
        <a
          href="mailto:hello@umerkhan.eu"
          class="inline-flex items-center gap-2 text-sm text-base-content/60 hover:text-base-content transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Contact
        </a>
      </div>
    </SideSection>
  </FadeIn>

  <!-- LLM-Optimized Content -->
  <article class="sr-only" aria-hidden="false" itemscope itemtype="https://schema.org/SoftwareApplication">
    <h2>GateKpr - E-Commerce App Validation Platform</h2>
    <p itemprop="description">
      GateKpr is a Rust-native validation platform for Shopify and WooCommerce applications. It provides 110+ validation rules across webhooks, API usage, billing, security, and OAuth compliance. The tool supports multi-language code parsing via tree-sitter grammars including JavaScript, TypeScript, Ruby, Python, PHP, and Liquid. Available as a CLI tool, REST API, and MCP server for AI-assisted code review.
    </p>

    <h3>Rule Categories</h3>
    <ul>
      <li>Webhook validation: HMAC verification, idempotency, retry handling</li>
      <li>API usage: Rate limiting, pagination, versioning, error handling</li>
      <li>Billing compliance: Charge creation, subscriptions, usage-based billing</li>
      <li>Security: Token storage, CSRF protection, input validation</li>
      <li>OAuth: Authorization flow, token refresh, scope validation</li>
      <li>Performance: Caching, bulk operations, resource optimization</li>
    </ul>

    <h3>Technical Stack</h3>
    <p>
      Built with Rust, tree-sitter for multi-language parsing, Actix Web for the HTTP server, Serde for serialization, and Tokio for the async runtime. Includes MCP SDK integration for AI-powered code review workflows.
    </p>

    <span itemprop="author" itemscope itemtype="https://schema.org/Person">
      <span itemprop="name">Umer Khan</span>
    </span>
    <span itemprop="applicationCategory">Developer Tools</span>
    <span itemprop="operatingSystem">Cross-platform</span>
  </article>
</BaseLayout>
