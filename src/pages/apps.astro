---
import BaseLayout from "../layouts/BaseLayout.astro";
import SideSection from "../components/SideSection.astro";

import { products as apps } from "../data/products";
---

<BaseLayout title="Products | Umer Khan" description="Products built or co-built by Umer Khan: ShopExtract, Sigma AI, GateKpr, DiMedi and ORY Berlin." sideBarActiveItemID="apps" geoPage="blog">
  <!-- Hero Section -->
  <section class="py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-6 lg:gap-12">
      <div class="lg:text-right">
        <span class="text-xs font-semibold uppercase tracking-widest text-base-content/40">Products</span>
      </div>
      <div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-base-content mb-4">
          Products
        </h1>
        <p class="text-base-content/60 leading-relaxed max-w-2xl">
          Products I have built or co-built, from open-source tools to live commerce platforms.
        </p>
      </div>
    </div>
  </section>

  <div class="w-full h-px bg-base-300/50"></div>

  <!-- Apps Section -->
  <SideSection title="All" subtitle={`${apps.length} total`}>
    <div class="space-y-8">
      {apps.map((app, index) => (
        <article class="group">
          <a
            href={app.link}
            target={app.external ? "_blank" : undefined}
            rel={app.external ? "noopener noreferrer" : undefined}
            data-astro-reload={!app.external ? "" : undefined}
            class="block"
          >
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl border border-base-300/60 bg-base-200/40 flex items-center justify-center shrink-0 mt-0.5">
                <div class="w-5 h-5 text-base-content/70" set:html={app.icon} />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2.5 mb-1">
                  <h3 class="text-lg font-semibold text-base-content group-hover:text-primary transition-colors tracking-tight">
                    {app.name}
                  </h3>
                  <span class="text-[11px] uppercase tracking-wider text-base-content/40">
                    {app.badge}
                  </span>
                  {app.external && (
                    <svg class="w-3.5 h-3.5 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                  )}
                </div>
                <p class="text-sm text-base-content/60 leading-relaxed">
                  {app.description}
                </p>
              </div>
            </div>
          </a>
          {index < apps.length - 1 && (
            <div class="w-full h-px bg-base-300/30 mt-8"></div>
          )}
        </article>
      ))}
    </div>
  </SideSection>
</BaseLayout>
