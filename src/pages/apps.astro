---
import BaseLayout from "../layouts/BaseLayout.astro";
import SideSection from "../components/SideSection.astro";

const apps = [
  {
    name: "GateKpr",
    description: "Rust-native validation platform for Shopify and WooCommerce apps. 110+ rules across webhooks, API usage, billing, security, and OAuth. Multi-language parsing via tree-sitter with CLI, REST API, and MCP server integration.",
    badge: "Developer Tool",
    link: "/gatekpr",
    external: false,
    gradient: "from-orange-500 to-amber-500",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>`
  },
  {
    name: "ShopExtract",
    description: "Extract, compare, and monitor product data from any e-commerce store. Works across Shopify, WooCommerce, Magento, BigCommerce, and custom stores with LLM-powered extraction.",
    badge: "Python CLI",
    link: "/shopextract",
    external: false,
    gradient: "from-violet-500 to-purple-500",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" /></svg>`
  },
  {
    name: "Sigma AI",
    description: "AI-powered sales agent for Shopify stores. Provides personalized product recommendations, answers customer questions, and helps convert visitors into buyers.",
    badge: "Shopify App",
    link: "/sigma-ai",
    external: false,
    gradient: "from-purple-500 to-blue-500",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" /></svg>`
  },
  {
    name: "GEO Optimizer",
    description: "Transform any website content into AI-citation-ready content. Optimize for ChatGPT, Claude, Perplexity, and other LLM-powered search engines using Generative Engine Optimization.",
    badge: "AI Tool",
    link: "/geo",
    external: false,
    gradient: "from-emerald-500 to-teal-500",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>`
  },
  {
    name: "DiMedi",
    description: "Healthcare practice management platform for therapy practices. Features telehealth video sessions, appointment scheduling, patient management, and multi-tenant architecture with HIPAA-compliant data handling.",
    badge: "Healthcare SaaS",
    link: "/dimedi",
    external: false,
    gradient: "from-rose-500 to-pink-500",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>`
  },
  {
    name: "ORY Berlin",
    description: "E-commerce health platform offering at-home laboratory testing, personalized coaching, and wellness products. Features blood analysis, microbiome checks, hormone panels, and integrated care programs across Europe.",
    badge: "Health E-Commerce",
    link: "/ory-berlin",
    external: false,
    gradient: "from-cyan-500 to-blue-500",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>`
  }
];
---

<BaseLayout title="Apps - Umer Khan" sideBarActiveItemID="apps">
  <!-- Hero Section -->
  <section class="py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[200px_1fr] gap-6 lg:gap-12">
      <div class="lg:text-right">
        <span class="text-xs font-semibold uppercase tracking-widest text-base-content/40">Products</span>
      </div>
      <div>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-base-content mb-4">
          Apps
        </h1>
        <p class="text-base-content/60 leading-relaxed max-w-2xl">
          Software products and applications I've built. {apps.length} {apps.length === 1 ? 'app' : 'apps'} available.
        </p>
      </div>
    </div>
  </section>

  <div class="w-full h-px bg-base-300/50"></div>

  <!-- Apps Section -->
  <SideSection title="Applications" subtitle={`${apps.length} total`}>
    <div class="space-y-8">
      {apps.map((app, index) => (
        <article class="group">
          <a
            href={app.link}
            target={app.external ? "_blank" : undefined}
            rel={app.external ? "noopener noreferrer" : undefined}
            data-astro-reload={!app.external ? "" : undefined}
            class="block"
          >
            <div class="flex items-start gap-4">
              <div class={`w-10 h-10 bg-gradient-to-br ${app.gradient} rounded-xl flex items-center justify-center shrink-0 mt-0.5`}>
                <div class="w-5 h-5 text-white" set:html={app.icon} />
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2.5 mb-1">
                  <h3 class="text-lg font-semibold text-base-content group-hover:text-primary transition-colors tracking-tight">
                    {app.name}
                  </h3>
                  <span class="px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider bg-primary/10 text-primary rounded-full">
                    {app.badge}
                  </span>
                  {app.external && (
                    <svg class="w-3.5 h-3.5 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                    </svg>
                  )}
                </div>
                <p class="text-sm text-base-content/60 leading-relaxed">
                  {app.description}
                </p>
              </div>
            </div>
          </a>
          {index < apps.length - 1 && (
            <div class="w-full h-px bg-base-300/30 mt-8"></div>
          )}
        </article>
      ))}
    </div>
  </SideSection>
</BaseLayout>
